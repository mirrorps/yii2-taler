{
  "name": "mirrorps/yii2-taler",
  "description": "Yii2 extension for GNU Taler REST API integration ",
  "type": "yii2-extension",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "yiisoft/yii2": "^2.0",
    "mirrorps/taler-php": "^1.2.2",
    "psr/http-client": "^1.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^10.0"
  },
  "autoload-dev": {
    "psr-4": {
      "mirrorps\\Yii2Taler\\Tests\\": "tests/"
    }
  },
  "autoload": {
    "psr-4": {
      "mirrorps\\Yii2Taler\\": "src/"
    }
  },
  "extra": {
    "bootstrap": "mirrorps\\Yii2Taler\\Bootstrap"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  }
}
